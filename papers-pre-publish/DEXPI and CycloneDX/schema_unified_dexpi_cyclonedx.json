{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigenia.nl/schemas/unified-dexpi-cyclonedx-v1.json",
  "title": "Unified DEXPI 2.0 & CycloneDX 1.6+ Cyber-Physical Digital Twin Schema",
  "description": "Defines a single computable graph linking physical process plant P&ID topology (ISO 15926 / DEXPI 2.0) with full-spectrum hierarchical supply chain multi-BOM (OWASP CycloneDX 1.6+).",
  "type": "object",
  "required": [
    "schemaVersion",
    "facilityMetadata",
    "physicalTopology",
    "cyberTopology",
    "crossOntologicalBindings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "facilityMetadata": {
      "type": "object",
      "required": ["facilityId", "facilityName", "powerCapacityMW", "coolingTopology"],
      "properties": {
        "facilityId": { "type": "string" },
        "facilityName": { "type": "string" },
        "powerCapacityMW": { "type": "number", "minimum": 0 },
        "coolingTopology": {
          "type": "string",
          "enum": ["DirectToChip_Liquid", "TwoPhase_Immersion", "SinglePhase_Immersion", "Hybrid_Air_Liquid"]
        },
        "perRackDensityKW": { "type": "number", "minimum": 0 }
      }
    },
    "physicalTopology": {
      "type": "object",
      "description": "DEXPI 2.0 plant breakdown structure, equipment list, and piping network segments",
      "required": ["equipment", "pipingNetworkSystems"],
      "properties": {
        "dexpiXmlSource": { "type": "string" },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DEXPIEquipment"
          }
        },
        "pipingNetworkSystems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PipingNetworkSystem"
          }
        }
      }
    },
    "cyberTopology": {
      "type": "object",
      "description": "OWASP CycloneDX 1.6+ multi-BOM containing HBOM, SBOM, OBOM, CBOM, and SaaSBOM",
      "required": ["bomFormat", "specVersion", "components"],
      "properties": {
        "bomFormat": { "type": "string", "const": "CycloneDX" },
        "specVersion": { "type": "string", "enum": ["1.5", "1.6"] },
        "serialNumber": { "type": "string" },
        "version": { "type": "integer" },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CycloneDXComponent"
          }
        },
        "vulnerabilities": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "crossOntologicalBindings": {
      "type": "array",
      "description": "Explicit semantic mapping between physical DEXPI equipment tags and CycloneDX bom-refs",
      "items": {
        "type": "object",
        "required": [
          "bindingId",
          "equipmentTag",
          "primaryBomRef",
          "purdueLevel",
          "controlRelationship",
          "failureModeConsequence"
        ],
        "properties": {
          "bindingId": { "type": "string" },
          "equipmentTag": { "type": "string" },
          "primaryBomRef": { "type": "string" },
          "purdueLevel": {
            "type": "string",
            "enum": ["Level-0", "Level-1", "Level-2", "Level-3", "Level-4"]
          },
          "controlRelationship": {
            "type": "string",
            "enum": ["DirectActuation", "TelemetrySensor", "SupervisoryController", "SafetyInstrumentedSystem"]
          },
          "securityLevelTarget": {
            "type": "string",
            "enum": ["SL-1", "SL-2", "SL-3", "SL-4"]
          },
          "failureModeConsequence": {
            "type": "string",
            "enum": [
              "HYDRAULIC_STARVATION_SECONDARY_LOOP",
              "PRESSURE_TRANSIENT_WATER_HAMMER",
              "THERMAL_RUNAWAY_DRAIN",
              "ELECTRICAL_BUS_TRIP",
              "FALSE_TELEMETRY_STARVATION"
            ]
          },
          "hardwiredAnalogInterlockPresent": { "type": "boolean" },
          "criticalThermalHorizonSeconds": { "type": "number" }
        }
      }
    }
  },
  "$defs": {
    "DEXPIEquipment": {
      "type": "object",
      "required": ["id", "componentClass", "tagName"],
      "properties": {
        "id": { "type": "string" },
        "componentClass": { "type": "string" },
        "tagName": { "type": "string" },
        "catalogTier": {
          "type": "string",
          "enum": ["Tier1_Requirement", "Tier2_VendorModel", "Tier3_ConfiguredAsset"]
        },
        "designParameters": {
          "type": "object",
          "properties": {
            "nominalFlowRateM3h": { "type": "number" },
            "designPressureBar": { "type": "number" },
            "fluidCode": { "type": "string" },
            "failSafeState": {
              "type": "string",
              "enum": ["FailOpen", "FailClosed", "HoldInPlace"]
            }
          }
        },
        "nozzles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nozzleId", "nominalDiameter", "flowDirection"],
            "properties": {
              "nozzleId": { "type": "string" },
              "nominalDiameter": { "type": "string" },
              "flowDirection": { "type": "string", "enum": ["Inlet", "Outlet"] }
            }
          }
        }
      }
    },
    "PipingNetworkSystem": {
      "type": "object",
      "required": ["systemId", "fluidCode", "segments"],
      "properties": {
        "systemId": { "type": "string" },
        "fluidCode": { "type": "string" },
        "nominalDiameter": { "type": "string" },
        "pipeClass": { "type": "string" },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segmentId", "sourceNode", "targetNode"],
            "properties": {
              "segmentId": { "type": "string" },
              "sourceNode": { "type": "string" },
              "targetNode": { "type": "string" },
              "lengthMeters": { "type": "number" },
              "frictionFactor": { "type": "number" }
            }
          }
        }
      }
    },
    "CycloneDXComponent": {
      "type": "object",
      "required": ["type", "bom-ref", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["device", "hardware", "firmware", "operating-system", "application", "cryptographic-asset", "service"]
        },
        "bom-ref": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "purl": { "type": "string" },
        "cpe": { "type": "string" },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/CycloneDXComponent" }
        }
      }
    }
  }
}
