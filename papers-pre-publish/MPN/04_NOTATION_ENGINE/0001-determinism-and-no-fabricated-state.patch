+export function rand(...parts: Array<string | number>): number {
+    return splitmix32(xmur3(buildKey(parts)));
+}
+
+/** An integer in [0, n), a pure function of the coordinates given. */
+export function randInt(n: number, ...parts: Array<string | number>): number {
+    if (n <= 0) return 0;
+    return Math.floor(rand(...parts) * n);
+}
+
+/** A float in [lo, hi), a pure function of the coordinates given. */
+export function randRange(lo: number, hi: number, ...parts: Array<string | number>): number {
+    return lo + rand(...parts) * (hi - lo);
+}
+
+/** True with probability p, a pure function of the coordinates given. */
+export function chance(p: number, ...parts: Array<string | number>): boolean {
+    return rand(...parts) < p;
+}
+
+/** Pick one element, a pure function of the coordinates given. Never empty-unsafe. */
+export function pick<T>(items: readonly T[], ...parts: Array<string | number>): T | undefined {
+    if (items.length === 0) return undefined;
+    return items[randInt(items.length, ...parts)];
+}
+
+/** Stable for a character across a whole work. Use for instrument and register. */
+export function characterKey(workId: string, characterId: string): string {
+    return `${workId}${SEP}${characterId}`;
+}
+
+/** Varies per frame. Use for performance choices inside one moment. */
+export function frameKey(workId: string, characterId: string, frameIndex: number): string {
+    return `${workId}${SEP}${characterId}${SEP}${frameIndex}`;
+}
