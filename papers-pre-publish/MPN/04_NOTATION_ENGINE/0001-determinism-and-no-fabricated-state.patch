@@ -0,0 +1,135 @@
+/**
+ * These tests are the evidence for A11. They are not unit tests in the usual
+ * sense: each one pins a property the theory asserts, and if one fails the
+ * corresponding claim in the paper is false.
+ */
+import {
+    rand, randInt, chance, pick, characterKey, frameKey,
+    SEED_ALGORITHM_VERSION,
+} from '../deterministic';
+
+describe('A11: the same state produces the same output', () => {
+    it('is stable across calls', () => {
+        const k = frameKey('hamlet', 'ophelia', 12);
+        expect(rand(k, 'melody.ornament', 0, 3)).toBe(rand(k, 'melody.ornament', 0, 3));
+    });
+
+    it('is stable across a thousand repetitions', () => {
+        const k = frameKey('macbeth', 'lady-macbeth', 4);
+        const first = rand(k, 'rhythm.syncopation', 2);
+        for (let i = 0; i < 1000; i++) {
+            expect(rand(k, 'rhythm.syncopation', 2)).toBe(first);
+        }
+    });
+});
+
+describe('A11: the output does not depend on call order', () => {
+    it('gives each character the same value whichever is drawn first', () => {
+        const a = frameKey('lear', 'cordelia', 7);
+        const b = frameKey('lear', 'goneril', 7);
+        const forwards = [rand(a, 'melody.velocity', 0, 1), rand(b, 'melody.velocity', 0, 1)];
+        const backwards = [rand(b, 'melody.velocity', 0, 1), rand(a, 'melody.velocity', 0, 1)];
+        expect(forwards[0]).toBe(backwards[1]);
+        expect(forwards[1]).toBe(backwards[0]);
+    });
+
+    it('is unaffected by unrelated draws made in between', () => {
+        const k = frameKey('oedipus', 'creon', 2);
+        const before = rand(k, 'voicing.flatNine');
+        for (let i = 0; i < 50; i++) rand(k, 'something.else', i);
+        expect(rand(k, 'voicing.flatNine')).toBe(before);
+    });
+});
+
+describe('change locality: adding a call site must not move existing stimuli', () => {
+    it('gives a new purpose string its own value', () => {
+        const k = frameKey('miss-julie', 'julie', 1);
+        const existing = rand(k, 'melody.ornament', 0, 0);
+        const added = rand(k, 'melody.ornamentSecondPass', 0, 0);
+        expect(added).not.toBe(existing);
+        expect(rand(k, 'melody.ornament', 0, 0)).toBe(existing);
+    });
+});
+
+describe('key scopes', () => {
+    it('holds a character choice steady across frames', () => {
+        const k = characterKey('hamlet', 'horatio');
+        expect(rand(k, 'instrument')).toBe(rand(k, 'instrument'));
+    });
+
+    it('separates characters', () => {
+        expect(rand(characterKey('hamlet', 'horatio'), 'instrument'))
+            .not.toBe(rand(characterKey('hamlet', 'hamlet'), 'instrument'));
+    });
+
+    it('lets a performance choice move between frames', () => {
+        expect(rand(frameKey('hamlet', 'hamlet', 1), 'melody.ornament', 0, 0))
+            .not.toBe(rand(frameKey('hamlet', 'hamlet', 2), 'melody.ornament', 0, 0));
+    });
+});
+
+describe('distribution is good enough for the use it is put to', () => {
+    it('is uniform within tolerance over ten thousand draws', () => {
+        const n = 10000;
+        const bins = new Array(10).fill(0);
+        for (let i = 0; i < n; i++) bins[Math.floor(rand('uniformity', i) * 10)]++;
+        for (const b of bins) expect(Math.abs(b - n / 10)).toBeLessThan(n / 10 * 0.15);
+    });
+
+    it('stays inside [0, 1)', () => {
+        for (let i = 0; i < 10000; i++) {
+            const v = rand('range', i);
+            expect(v).toBeGreaterThanOrEqual(0);
+            expect(v).toBeLessThan(1);
+        }
+    });
+
+    it('does not correlate consecutive keys', () => {
+        const xs: number[] = [], ys: number[] = [];
+        for (let i = 0; i < 5000; i++) { xs.push(rand('corr', i)); ys.push(rand('corr', i + 1)); }
+        const mx = xs.reduce((a, b) => a + b) / xs.length;
+        const my = ys.reduce((a, b) => a + b) / ys.length;
+        let num = 0, dx = 0, dy = 0;
+        for (let i = 0; i < xs.length; i++) {
+            num += (xs[i] - mx) * (ys[i] - my);
+            dx += (xs[i] - mx) ** 2; dy += (ys[i] - my) ** 2;
+        }
+        expect(Math.abs(num / Math.sqrt(dx * dy))).toBeLessThan(0.05);
+    });
+});
+
+describe('helpers stay in range', () => {
+    it('randInt', () => {
+        for (let i = 0; i < 2000; i++) {
+            const v = randInt(7, 'int', i);
+            expect(v).toBeGreaterThanOrEqual(0);
+            expect(v).toBeLessThan(7);
+            expect(Number.isInteger(v)).toBe(true);
+        }
+    });
+    it('randInt of zero is safe', () => expect(randInt(0, 'zero')).toBe(0));
+    it('chance is monotone in p', () => {
+        const count = (p: number) => {
+            let c = 0;
+            for (let i = 0; i < 3000; i++) if (chance(p, 'chance', i)) c++;
+            return c;
+        };
+        expect(count(0.2)).toBeLessThan(count(0.8));
+    });
+    it('pick of an empty list is undefined', () => expect(pick([], 'empty')).toBeUndefined());
+});
+
+describe('the algorithm is pinned to its version', () => {
+    it('has not changed without the version being bumped', () => {
+        // If these fail, someone changed the hash. Every stimulus rendered under
+        // version SEED_ALGORITHM_VERSION is now a different stimulus. Either revert,
+        // or bump the version deliberately and replace these values, and say so in
+        // the paper, because previously rendered cues are no longer citable.
+        // Pinned explicitly rather than by snapshot, because a snapshot can be
+        // regenerated silently with -u and these values must not be.
+        expect(SEED_ALGORITHM_VERSION).toBe(1);
+        expect(rand('golden', 'a')).toBeCloseTo(0.8563087894581258, 15);
+        expect(rand(frameKey('hamlet', 'ophelia', 12), 'melody.ornament', 0, 3))
+            .toBeCloseTo(0.23955746344290674, 15);
+    });
+});
diff --git a/src/lib/deterministic.ts b/src/lib/deterministic.ts
new file mode 100644
index 0000000..a6289e3
--- /dev/null
+++ b/src/lib/deterministic.ts
@@ -0,0 +1,159 @@
+/**
+ * Deterministic keyed randomness.
+ *
+ * WHY THIS EXISTS
+ * ---------------
+ * The theory's assertion A11 says the transformation from psychological state to
+ * musical parameters is total, deterministic and decomposable. Before this module
+ * the composer and the calculus made eleven unseeded calls to Math.random(), so
+ * the same state did not produce the same score and a user discovered it by
+ * pressing render twice. That blocked every listening study in the programme,
+ * because a stimulus that cannot be reproduced cannot be cited.
+ *
+ * WHY NOT ONE SEEDED STREAM
+ * -------------------------
+ * The obvious fix is a single global generator seeded once at startup. It makes a
+ * run reproducible and it is the wrong fix, for two reasons.
+ *
+ * First, it makes the output a function of state AND CALL ORDER. Render character
+ * A then B and you get a different result than B then A, because they draw from
+ * the same stream. A11 asserts a function of state. A global stream gives a
+ * function of state and position in the queue, which is a different and weaker
+ * claim, and one that breaks silently the moment anything renders concurrently.
+ *
+ * Second, it makes every previously rendered stimulus invalid whenever anyone adds
+ * a draw anywhere. Insert one ornament decision early in the composer and every
+ * subsequent draw in the whole run shifts. In a research programme where rendered
+ * cues have to stay citable across code changes, that is fatal.
+ *
+ * WHAT THIS DOES INSTEAD
+ * ----------------------
+ * Every draw is a pure function of its own coordinates. There is no stream and no
+ * state. `rand('hamlet', 'ophelia', 12, 'ornament')` returns the same number
+ * forever, regardless of what else was drawn, in what order, or whether other call
+ * sites were added or removed. Two consequences worth having:
+ *
+ *   - Order independence is structural rather than a property anyone has to
+ *     maintain. Concurrent rendering is safe.
+ *   - Change locality. Adding a draw with a new purpose string leaves every
+ *     existing draw untouched, so a cue rendered last month still renders the same
+ *     today.
+ *
+ * TWO KEY SCOPES
+ * --------------
+ * S1 section 6 already draws the line this module implements: the transformation
+ * is deterministic, and any stochastic element "sits downstream of the
+ * transformation, in performance rather than in composition."
+ *
+ *   characterKey(work, character)          stable for a character across a work
+ *   frameKey(work, character, frameIndex)  varies per frame
+ *
+ * Choices belonging to a character use the character scope. A character's
+ * instrument is the clear case, and keying it per frame was a musical bug as well
+ * as a determinism one: it reassigned the instrument on every frame.
+ *
+ * Choices belonging to a moment of performance, ornament, syncopation, velocity
+ * inflection, voicing alteration, use the frame scope. None of them changes a
+ * named musical parameter of the theory; mode, dynamics, the fragmentation stage
+ * and the density level are computed and never drawn.
+ *
+ * VERSIONING
+ * ----------
+ * SEED_ALGORITHM_VERSION is part of every key. Changing the hash changes every
+ * rendered stimulus in the programme, so it must be a deliberate, visible act
+ * rather than a side effect of a refactor. Bumping it is how you say "these are
+ * new stimuli"; leaving it alone is how a rendered cue stays the cue it was.
+ * `src/lib/__tests__/deterministic.test.ts` pins exact values against this
+ * version and will fail if anyone changes the algorithm without bumping it.
+ */
+
+/** Bump ONLY to deliberately invalidate every previously rendered stimulus. */
+export const SEED_ALGORITHM_VERSION = 1;
+
+/** Unit separator. Cannot occur in an id, so keys are unambiguous. */
+const SEP = '';
+
+/** Used when a call site has not been given a key. Deterministic, not random. */
+export const UNKEYED = 'UNKEYED';
+
+let warnedUnkeyed = false;
+
+/**
+ * xmur3 string hash. Integer arithmetic only, via Math.imul and >>> 0, so the
+ * result is identical on every JavaScript engine. Floating point anywhere in a
+ * hash makes it engine dependent, which would make stimuli unciteable across
+ * browsers.
+ */
+function xmur3(str: string): number {
+    let h = 1779033703 ^ str.length;
+    for (let i = 0; i < str.length; i++) {
+        h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
+        h = (h << 13) | (h >>> 19);
+    }
+    h = Math.imul(h ^ (h >>> 16), 2246822507);
+    h = Math.imul(h ^ (h >>> 13), 3266489909);
+    return (h ^ (h >>> 16)) >>> 0;
+}
+
+/** splitmix32 finaliser. One integer in, one uniform float in [0, 1) out. */
+function splitmix32(seed: number): number {
+    let a = (seed + 0x9e3779b9) | 0;
+    let t = a ^ (a >>> 16);
+    t = Math.imul(t, 0x21f0aaad);
+    t = t ^ (t >>> 15);
+    t = Math.imul(t, 0x735a2d97);
+    t = t ^ (t >>> 15);
+    return (t >>> 0) / 4294967296;
+}
+
+function buildKey(parts: Array<string | number>): string {
+    if (parts.length === 0 || parts[0] === UNKEYED) {
+        if (!warnedUnkeyed && typeof console !== 'undefined') {
+            warnedUnkeyed = true;
+            console.warn(
+                '[deterministic] a draw was made with no seed key. Output is still ' +
+                'reproducible, but every unkeyed call site shares one key, so ' +
+                'different characters will receive identical performance choices. ' +
+                'Thread a characterKey or frameKey through to this call site.'
+            );
+        }
