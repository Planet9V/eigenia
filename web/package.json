{
  "name": "eigenia-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-publications.js",
    "audit": "node scripts/run-audits.mjs",
    "predev": "node scripts/sync-publications.js",
    "prebuild": "node scripts/sync-publications.js && node scripts/run-audits.mjs",
    "dev": "next dev -p 4500",
    "build": "next build",
    "start": "next start -p 4500",
    "lint": "next lint",
    "audit:quick": "node scripts/run-audits.mjs --quick",
    "audit:list": "node scripts/run-audits.mjs --list",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "verify": "npm run sync && tsc --noEmit && npm run audit && npm run test:run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.17.2",
    "next": "^15.1.7",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
